# PAP Environment Configuration Example
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file with credentials.

# Django
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# T-MOM API Configuration
TMOM_BASE_URL=https://iipl-mom.transsion.com
TMOM_FPY_ENDPOINT=/mom-gateway/mom-reporting/workOrderFtyReport/queryDetail
TMOM_OAUTH_ENDPOINT=/mom-gateway/mom-auth/oauth/token

# T-MOM Credentials
# NOTE: TMOM_USERNAME and TMOM_PASSWORD are configured in the Django admin /
# environment. Put your real T-MOM credentials here.
TMOM_USERNAME=
TMOM_PASSWORD=

# T-MOM Application Headers
TMOM_APP_ID=c_MjMxMjAxMDAxYw
TMOM_CHANNEL=PC
TMOM_REFERER=https://iipl-mom.transsion.com/mompc/
TMOM_TIMEOUT=30

# T-MOM serves an internal/self-signed TLS certificate.
# Keep False unless a corporate CA is installed.
TMOM_VERIFY_SSL=False
